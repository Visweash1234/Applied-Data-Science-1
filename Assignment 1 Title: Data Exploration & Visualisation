        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import re\n",
        "\n",
        "# Set visual style\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "\n",
        "# ==========================================\n",
        "# 1. DATA PREPROCESSING & CLEANING FUNCTION\n",
        "# ==========================================\n",
        "def load_and_clean_data(file_path: str) -> pd.DataFrame:\n",
        "    \"\"\"\n",
        "    Loads raw excel data, merges country metadata, cleans dirty string formatting,\n",
        "    converts year columns to numeric, and returns a tidy long-format DataFrame.\n",
        "    \"\"\"\n",
        "    xls = pd.ExcelFile(file_path)\n",
        "    raw_df = pd.read_excel(xls, sheet_name='Raw_Data')\n",
        "    country_meta = pd.read_excel(xls, sheet_name='Country_Metadata')\n",
        "\n",
        "    # Merge Region and Income Group metadata\n",
        "    merged_df = pd.merge(\n",
        "        raw_df,\n",
        "        country_meta[['Country Code', 'Region', 'IncomeGroup']],\n",
        "        on='Country Code',\n",
        "        how='left'\n",
        "    )\n",
        "\n",
        "    # Identify year columns (1991 to 2025 contain data)\n",
        "    year_cols = [str(y) for y in range(1991, 2026)]\n",
        "\n",
        "    # Function to clean noisy numeric strings\n",
        "    def clean_value(val):\n",
        "        if pd.isna(val):\n",
        "            return np.nan\n",
        "        val_str = str(val).strip().lower()\n",
        "        if val_str in ['unknown', 'n.a.', 'missing', '--', 'nan', '']:\n",
        "            return np.nan\n",
        "        # Replace commas with dots and extract valid decimal numbers\n",
        "        val_str = val_str.replace(',', '.')\n",
        "        match = re.search(r\"[-+]?\\d*\\.\\d+|\\d+\", val_str)\n",
        "        return float(match.group()) if match else np.nan\n",
        "\n",
        "    # Clean all year columns\n",
        "    for col in year_cols:\n",
        "        merged_df[col] = merged_df[col].apply(clean_value)\n",
        "\n",
        "    # Melt into Long-Format for flexible analysis & visualization\n",
        "    id_vars = ['Country Name', 'Country Code', 'Region', 'IncomeGroup', 'Indicator Name', 'Indicator Code']\n",
        "    long_df = pd.melt(\n",
        "        merged_df,\n",
        "        id_vars=id_vars,\n",
        "        value_vars=year_cols,\n",
        "        var_name='Year',\n",
        "        value_name='Male_Agri_Employment_Pct'\n",
        "    )\n",
        "    long_df['Year'] = long_df['Year'].astype(int)\n",
        "\n",
        "    return long_df\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 2. REQUIRED MODULAR VISUALISATION FUNCTIONS\n",
        "# ==========================================\n",
        "\n",
        "def plot_relational(df: pd.DataFrame, target_countries: list) -> None:\n",
        "    \"\"\"\n",
        "    1. RELATIONAL PLOT:\n",
        "    Displays line plot trends of Male Agricultural Employment (% of male employment)\n",
        "    over time (1991-2025) for selected countries.\n",
        "    \"\"\"\n",
        "    filtered_df = df[df['Country Name'].isin(target_countries)].dropna(subset=['Male_Agri_Employment_Pct'])\n",
        "\n",
        "    plt.figure(figsize=(10, 5))\n",
        "    sns.lineplot(\n",
        "        data=filtered_df,\n",
        "        x='Year',\n",
        "        y='Male_Agri_Employment_Pct',\n",
        "        hue='Country Name',\n",
        "        marker='o',\n",
        "        linewidth=2.5\n",
        "    )\n",
        "    plt.title('Relational Analysis: Male Employment in Agriculture (1991–2025)', fontsize=13, fontweight='bold')\n",
        "    plt.xlabel('Year', fontsize=11)\n",
        "    plt.ylabel('Male Employment in Agriculture (%)', fontsize=11)\n",
        "    plt.legend(title='Country', bbox_to_anchor=(1.05, 1), loc='upper left')\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "\n",
        "def plot_categorical(df: pd.DataFrame, target_year: int = 2022) -> None:\n",
        "    \"\"\"\n",
        "    2. CATEGORICAL PLOT:\n",
        "    Compares average Male Agricultural Employment percentage across Income Groups\n",
        "    for a specific reference year using a bar plot.\n",
        "    \"\"\"\n",
        "    year_df = df[(df['Year'] == target_year) & df['IncomeGroup'].notna()].copy()\n",
        "\n",
        "    # Calculate group means\n",
        "    avg_df = year_df.groupby('IncomeGroup')['Male_Agri_Employment_Pct'].mean().reset_index()\n",
        "    avg_df = avg_df.sort_values(by='Male_Agri_Employment_Pct', ascending=False)\n",
        "\n",
        "    plt.figure(figsize=(9, 5))\n",
        "    ax = sns.barplot(\n",
        "        data=avg_df,\n",
        "        x='IncomeGroup',\n",
        "        y='Male_Agri_Employment_Pct',\n",
        "        palette='Blues_r'\n",
        "    )\n",
        "\n",
        "    plt.title(f'Categorical Analysis: Average Male Agricultural Employment by Income Group ({target_year})', fontsize=12, fontweight='bold')\n",
        "    plt.xlabel('Income Group Category', fontsize=11)\n",
        "    plt.ylabel('Average Male Employment (%)', fontsize=11)\n",
        "    plt.xticks(rotation=15)\n",
        "\n",
        "    # Annotate bars with values\n",
        "    for p in ax.patches:\n",
        "        ax.annotate(f\"{p.get_height():.1f}%\",\n",
        "                    (p.get_x() + p.get_width() / 2., p.get_height()),\n",
        "                    ha='center', va='center', xytext=(0, 5),\n",
        "                    textcoords='offset points', fontsize=10)\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "\n",
        "def plot_statistical(df: pd.DataFrame, year_a: int = 1995, year_b: int = 2022) -> None:\n",
        "    \"\"\"\n",
        "    3. STATISTICAL PLOT:\n",
        "    Kernel Density Estimate (KDE) and Distribution comparing global male agri-employment\n",
        "    spread between two distinct years to highlight long-term structural shifts.\n",
        "    \"\"\"\n",
        "    compare_df = df[df['Year'].isin([year_a, year_b]) & df['Region'].notna()].copy()\n",
        "\n",
        "    plt.figure(figsize=(10, 5))\n",
        "    sns.kdeplot(\n",
        "        data=compare_df,\n",
        "        x='Male_Agri_Employment_Pct',\n",
        "        hue='Year',\n",
        "        fill=True,\n",
        "        common_norm=False,\n",
        "        palette='Set1',\n",
        "        alpha=0.4\n",
        "    )\n",
        "    plt.title(f'Statistical Distribution Shift: Global Male Agri-Employment ({year_a} vs {year_b})', fontsize=12, fontweight='bold')\n",
        "    plt.xlabel('Male Agricultural Employment (% of male employment)', fontsize=11)\n",
        "    plt.ylabel('Density', fontsize=11)\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "\n",
        "# ==========================================\n",
        "# 3. EXECUTION EXAMPLE\n",
        "# ==========================================\n",
        "if __name__ == \"__main__\":\n",
        "    file_path = '/content/1.Employment_Agriculture_Male_ASSIGNMENT_1_BB (1).xlsx'\n",
        "\n",
        "    # Load and clean\n",
        "    cleaned_df = load_and_clean_data(file_path)\n",
        "    print(\"Cleaned Data Sample:\")\n",
        "    print(cleaned_df.head())\n",
        "\n",
        "    # Generate Visualisations\n",
        "    plot_relational(cleaned_df, target_countries=['Barbados', 'Jamaica', 'Gabon'])\n",
        "    plot_categorical(cleaned_df, target_year=2022)\n",
        "    plot_statistical(cleaned_df, year_a=1995, year_b=2022)"
      ],
